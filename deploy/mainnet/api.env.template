# ============================================================
# Nester API — MAINNET profile (#1371)
#
# This is a template for the mainnet deployment's secret store, NOT a .env
# file. With STELLAR_NETWORK=mainnet the API refuses to start if a .env file
# is present, so a developer's testnet config can never leak into a mainnet
# process. Inject these as process environment variables from the secret
# manager, under a mainnet-only path that testnet/staging deploys cannot read.
#
# Values marked <secret:...> must be generated for mainnet. Never reuse a
# testnet or staging value — keys, JWT secret, DB, Redis, provider keys and
# cipher keys are all mainnet-only.
# ============================================================

# --- Network profile (checked at startup) ---
APP_ENV=production
STELLAR_NETWORK=mainnet
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_HORIZON_URL=https://horizon.stellar.org
# SDF does not run a public mainnet Soroban RPC; use a dedicated provider.
# The API calls getNetwork at boot and refuses to start unless it reports the
# mainnet passphrase.
STELLAR_RPC_URL=<mainnet soroban rpc url>
# Circle USDC on mainnet. Must be set explicitly; the testnet issuer is rejected.
STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# --- Mainnet contract addresses (from the mainnet deploy record) ---
YIELD_REGISTRY_CONTRACT=<C... mainnet yield_registry>
STELLAR_ALLOCATION_STRATEGY_ADDRESS=<C... mainnet allocation_strategy>
# N-of-M multisig account contract holding Admin/Upgrader/Guardian/Treasurer
# (#1374). Must be a C... contract address.
STELLAR_ADMIN_MULTISIG_ADDRESS=<C... mainnet admin multisig>

# --- Operator key ---
# Holds only Operator/RebalanceKeeper-level roles on mainnet. It must NOT hold
# Admin, Upgrader, Guardian or Treasurer; those belong to the multisig.
STELLAR_OPERATOR_SECRET=<secret:mainnet/api/operator-secret>

# --- Secrets (mainnet-only) ---
DATABASE_DSN=<secret:mainnet/api/database-dsn>
REDIS_ADDR=<secret:mainnet/api/redis-addr>
AUTH_JWT_SECRET=<secret:mainnet/api/jwt-secret>
NESTER_SERVICE_API_KEY=<secret:mainnet/api/service-api-key>
INTELLIGENCE_SERVICE_API_KEY=<secret:mainnet/intelligence/service-api-key>
ACCOUNT_CIPHER_KEYS=<secret:mainnet/api/account-cipher-keys>
ACCOUNT_CIPHER_ACTIVE_KEY=<secret:mainnet/api/account-cipher-active-key>
ACCOUNT_CIPHER_FINGERPRINT_KEY=<secret:mainnet/api/account-cipher-fingerprint-key>
PAYSTACK_SECRET_KEY=<secret:mainnet/api/paystack-live-key>
FLUTTERWAVE_SECRET_KEY=<secret:mainnet/api/flutterwave-live-key>

# --- Serving ---
ALLOWED_ORIGINS=<https://app.nester.example>
RUN_MIGRATIONS=false
LOG_FORMAT=json
